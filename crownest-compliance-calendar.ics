BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:GSTR-1 due in 4 days (due 11th)
TRIGGER:-P4D
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:GSTR-1 due TOMORROW (11th)
TRIGGER:-P1D
END:VALARM
END:VEVENT
BEGIN:VEVENT
